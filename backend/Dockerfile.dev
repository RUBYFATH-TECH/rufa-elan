FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Install ts-node and nodemon globally for development
RUN npm install -g ts-node nodemon

# Copy source code
COPY . .

# Create logs directory
RUN mkdir -p logs

# Expose port
EXPOSE 8000

# Development command
CMD ["npm", "run", "dev"]