# Backend Environment Variables for RUFA ELAN

# Server Configuration
PORT=8000
NODE_ENV=production

# Supabase Configuration (Backend)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_STORAGE_URL=your_supabase_storage_url
PROJECT_ID=your_project_id

# Admin Configuration (Backend)
ADMIN_SECRET_CODE=your_admin_secret_code

# JWT Configuration (Backend)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret

# CORS Configuration
CORS_ORIGIN=https://your-frontend-domain.vercel.app
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Payment Gateway Configuration (Backend)
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# File Upload Configuration (Backend)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Backend)
RESEND_API_KEY=your_resend_api_key

# Redis Configuration (Backend) - Optional for caching
REDIS_URL=redis://localhost:6379

# Session Configuration (Backend)
SESSION_SECRET=your-session-secret-key

# Rate Limiting (Backend)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security (Backend)
BCRYPT_SALT_ROUNDS=12

# Google OAuth Configuration (Backend)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_URL=https://your-frontend-domain.vercel.app
