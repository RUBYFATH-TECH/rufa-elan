# Shared Environment Variables for RUFA ELAN Project

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/rufa-elan
# OR for MongoDB Atlas:
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/rufa-elan

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Application Environment
NODE_ENV=development

# API Configuration
API_PORT=8000
CLIENT_PORT=3000

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Redis Configuration (for sessions/caching)
REDIS_URL=redis://localhost:6379

# Production URLs (update for production)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000